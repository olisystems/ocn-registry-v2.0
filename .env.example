# DISCLAIMER: never use these keys in production.
# Copy to .env and fill with your own values.

# -----------------------------
# Required for deployment flow
# -----------------------------
DEPLOYER_PRIVATE_KEY=0xaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa
GRAPH_DEPLOY_KEY=your_graph_studio_deploy_key

# ----------------------------------------
# Optional deployment behavior overrides
# ----------------------------------------
DEFAULT_OPERATOR=0x0000000000000000000000000000000000000000
ALLOWED_VERIFIERS=0xVerifierAddress1,0xVerifierAddress2
# Used by deploy/06_deployOcnPaymentManager.ts (external stablecoin flow)
STABLECOIN_ADDRESS=0x0000000000000000000000000000000000000000
# Used by deploy/06_deployOcnPaymentManager.ts (mock flow)
STABLECOIN_DEPLOYMENT_NAME=MockERC20
# Required for subgraph deployment (passed directly to graph deploy --version-label)
GRAPH_VERSION_LABEL=v0.0.8

# --------------------
# Optional infra/config
# --------------------
ETHERSCAN_API_KEY=your_etherscan_api_key
MINIKUBE_HARDHAT_HOST=localhost
OCN_REGISTRY_RPC_URL=https://your-rpc-url
RPC_URL=https://fallback-rpc-url
